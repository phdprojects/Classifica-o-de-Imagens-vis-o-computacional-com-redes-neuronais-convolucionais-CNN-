    "# ==============================================================================\n",
    "# STEP 2: CARREGAMENTO DO CIFAR-10 E DIVISÃO TREINO/TESTE DESDE O INÍCIO\n",
    "# ==============================================================================\n",
    "# Objectivo: Carregar o dataset CIFAR-10 directamente do Keras, já dividido em\n",
    "# treino e teste (evita leakage de dados), explorar a estrutura (dimensões,\n",
    "# tipos, intervalo de valores) e validar a segurança dos dados.\n",
    "#\n",
    "# Input:  Dataset CIFAR-10 embutido no Keras (keras.datasets.cifar10)\n",
    "# Output: x_train, y_train, x_test, y_test, CLASS_NAMES (variáveis globais)\n",
    "#\n",
    "# Operações:\n",
    "#   - Carregar o CIFAR-10 com a divisão original 50.000 treino / 10.000 teste\n",
    "#   - Explorar dimensões, tipos e conteúdo dos arrays\n",
    "#   - Validar segurança: valores nulos, intervalo de píxeis, etiquetas válidas\n",
    "#   - Confirmar distribuição equilibrada das 10 classes\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from tensorflow.keras.datasets import cifar10\n",
    "\n",
    "# Nomes das 10 categorias pela ordem oficial do CIFAR-10 (índices 0 a 9)\n",
    "CLASS_NAMES = ['avião', 'automóvel', 'pássaro', 'gato', 'veado',\n",
    "               'cão', 'rã', 'cavalo', 'navio', 'camião']\n",
    "\n",
    "# --- Carregamento: o split treino/teste é o oficial do dataset -------------\n",
    "# Desde o primeiro momento, evitando qualquer fuga de dados (leakage)\n",
    "(x_train, y_train), (x_test, y_test) = cifar10.load_data()\n",
    "\n",
    "# --- Exploração da estrutura e dimensões -------------------------------------\n",
    "print(\"Dimensões dos arrays:\")\n",
    "print(f\"  x_train: {x_train.shape} | y_train: {y_train.shape}\")\n",
    "print(f\"  x_test : {x_test.shape} | y_test : {y_test.shape}\")\n",
    "print(f\"\\nTipos: píxeis = {x_train.dtype}, etiquetas = {y_train.dtype}\")\n",
    "print(f\"Estrutura de cada imagem: {x_train.shape[1]}x{x_train.shape[2]} píxeis, {x_train.shape[3]} canais (RGB)\")\n",
    "\n",
    "# --- Validação de segurança dos dados (antes de qualquer transformação) -----\n",
    "print(\"\\n--- Segurança dos dados ---\")\n",
    "print(f\"Intervalo de valores dos píxeis (treino): [{x_train.min()}, {x_train.max()}]\")\n",
    "print(f\"Imagens com valores nulos (treino): {np.isnan(x_train).sum()}\")\n",
    "print(f\"Imagens com valores nulos (teste) : {np.isnan(x_test).sum()}\")\n",
    "print(f\"Etiquetas únicas no treino: {sorted(np.unique(y_train).tolist())}\")\n",
    "print(f\"Etiquetas únicas no teste : {sorted(np.unique(y_test).tolist())}\")\n",
    "\n",
    "# Confirmar que as etiquetas estão dentro do intervalo válido [0, 9]\n",
    "assert set(np.unique(y_train)).issubset(set(range(10))), \"Etiquetas inválidas no treino!\"\n",
    "assert set(np.unique(y_test)).issubset(set(range(10))), \"Etiquetas inválidas no teste!\"\n",
    "print(\"OK: todas as etiquetas são válidas (0 a 9) e não há valores nulos.\")\n",
    "\n",
    "# --- Distribuição das classes (verificar equilíbrio) -------------------------\n",
    "dist_treino = pd.Series(y_train.flatten()).value_counts().sort_index()\n",
    "dist_teste = pd.Series(y_test.flatten()).value_counts().sort_index()\n",
    "distribuicao = pd.DataFrame({\n",
    "    'classe': CLASS_NAMES,\n",
    "    'imagens_treino': dist_treino.values,\n",
    "    'imagens_teste': dist_teste.values,\n",
    "})\n",
    "print(\"\\nDistribuição das classes:\")\n",
    "print(distribuicao.to_string(index=False))\n",
    "print(f\"\\nTotal: {len(x_train)} imagens de treino + {len(x_test)} imagens de teste = {len(x_train) + len(x_test)}\")\n",
    "print(\"\\nSTEP 2 concluído: dataset carregado, estrutura validada e split seguro.\")"
   ]
