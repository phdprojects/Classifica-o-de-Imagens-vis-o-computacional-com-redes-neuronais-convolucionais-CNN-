    "# ==============================================================================\n",
    "# STEP 6: CONSTRUÇÃO E COMPILAÇÃO DA CNN\n",
    "# ==============================================================================\n",
    "# Objectivo: definir a arquitetura da rede neuronal convolucional — blocos de\n",
    "# camadas convolucionais (extração de características), pooling (redução de\n",
    "# dimensionalidade) e dropout (regularização contra overfitting) — e compilá-la\n",
    "# com o otimizador Adam e a loss categorical crossentropy (adequada a etiquetas\n",
    "# one-hot com 10 classes).\n",
    "#\n",
    "# Input:  Dimensão das imagens (32x32x3) e número de classes (10)\n",
    "# Output: modelo_cnn — modelo Keras compilado, pronto para treinar no STEP 7\n",
    "#\n",
    "# Operações:\n",
    "#   - Arquitectura: 2 blocos conv (Conv+Conv+MaxPool+Dropout) + Dense final\n",
    "#   - Compilação: Adam + categorical crossentropy + métrica acurácia\n",
    "#   - Validar: dimensão de saída (10), parâmetros e presença de dropout\n",
    "\n",
    "import numpy as np\n",
    "import tensorflow as tf\n",
    "from tensorflow import keras\n",
    "from tensorflow.keras import layers\n",
    "\n",
    "# --- Arquitectura da CNN -------------------------------------------------------\n",
    "modelo_cnn = keras.Sequential([\n",
    "    # Input: imagens 32x32 com 3 canais (RGB), já normalizadas [0, 1]\n",
    "    keras.Input(shape=(32, 32, 3)),\n",
    "\n",
    "    # Bloco 1: 32 filtros — detecta bordas, cores e texturas simples\n",
    "    layers.Conv2D(32, (3, 3), activation='relu', padding='same'),\n",
    "    layers.Conv2D(32, (3, 3), activation='relu', padding='same'),\n",
    "    layers.MaxPooling2D((2, 2)),      # 32x32 -> 16x16 (reduz dimensão, mantém padrões)\n",
    "    layers.Dropout(0.25),            # desliga 25% dos neurónios (anti-overfitting)\n",
    "\n",
    "    # Bloco 2: 64 filtros — detecta formas compostas (rodas, patas, asas)\n",
    "    layers.Conv2D(64, (3, 3), activation='relu', padding='same'),\n",
    "    layers.Conv2D(64, (3, 3), activation='relu', padding='same'),\n",
    "    layers.MaxPooling2D((2, 2)),      # 16x16 -> 8x8\n",
    "    layers.Dropout(0.25),\n",
    "\n",
    "    # Classificador: achata para vector e decide entre as 10 categorias\n",
    "    layers.Flatten(),\n",
    "    layers.Dense(256, activation='relu'),\n",
    "    layers.Dropout(0.5),             # dropout mais forte antes da camada final\n",
    "    layers.Dense(10, activation='softmax'),  # probabilidade por classe (soma = 1)\n",
    "], name='cnn_cifar10')\n",
    "\n",
    "# --- Compilação: Adam + categorical crossentropy (etiquetas one-hot) ---------\n",
    "modelo_cnn.compile(\n",
    "    optimizer='adam',                          # ajuste adaptativo da taxa de aprendizagem\n",
    "    loss='categorical_crossentropy',           # padrão para multiclasse com one-hot\n",
    "    metrics=['accuracy'],\n",
    ")\n",
    "\n",
    "# --- Validação do modelo (regra 8: dimensões e estrutura corretas) ------------\n",
    "modelo_cnn.summary()\n",
    "\n",
    "n_params = modelo_cnn.count_params()\n",
    "n_dropout = sum(1 for l in modelo_cnn.layers if isinstance(l, layers.Dropout))\n",
