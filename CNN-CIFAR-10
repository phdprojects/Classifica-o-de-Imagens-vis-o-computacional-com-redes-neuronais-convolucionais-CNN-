    "        marca = 'complexo pior' if err_c > err_s else 'simples pior'\n",
    "        if err_c > err_s:\n",
    "            classes_pior_complexo += 1\n",
    "        print(f'  {CLASS_NAMES[c]:<10} simples {err_s:.1%} vs complexo {err_c:.1%}  ({marca})')\n",
    "\n",
    "# --- Resposta (calculada a partir dos dados) ---------------------------------\n",
    "resposta = 'SIM' if taxa['complexo'] > taxa['simples'] else 'NÃO'\n",
    "print()\n",
    "print(f'RESPOSTA: {resposta}. Globalmente, a taxa de erro em imagens complexas é '\n",
    "      f'{taxa[\"complexo\"]:.1%} vs {taxa[\"simples\"]:.1%} em imagens simples '\n",
    "      f'(diferença de {(taxa[\"complexo\"] - taxa[\"simples\"]) * 100:.1f} pontos percentuais).')\n",
    "print(f'Por classe, o nível complexo é pior em {classes_pior_complexo} de 10 categorias.')\n",
