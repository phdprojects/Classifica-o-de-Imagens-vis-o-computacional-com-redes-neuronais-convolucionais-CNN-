    "# ==============================================================================\n",
    "# STEP 5: AMOSTRA DAS PRIMEIRAS 77 LINHAS COM TODAS AS VARIÁVEIS VISÍVEIS\n",
    "# ==============================================================================\n",
    "# Objectivo: Mostrar a estrutura do dataset em formato tabular — as primeiras\n",
    "# 77 imagens (linhas) de treino, já normalizadas, com todas as variáveis\n",
    "# visíveis: identificador, etiqueta, classe, estatísticas de píxeis por canal\n",
    "# e as 10 colunas do one-hot encoding.\n",
    "#\n",
    "# Input:  x_train_norm, y_train, y_train_onehot, CLASS_NAMES (STEPS 2 e 4)\n",
    "# Output: df_preview — tabela 77 linhas x 20 colunas (display interactiva)\n",
    "#\n",
    "# Operações:\n",
    "#   - Construir DataFrame: 1 linha = 1 imagem, com estatísticas por canal RGB\n",
    "#   - Juntar as 10 colunas one-hot (a matriz que a CNN recebe como etiqueta)\n",
    "#   - Validar: dimensões, nulos e coerência etiqueta vs one-hot\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "N_LINHAS = 77  # primeiras 77 imagens do conjunto de treino\n",
    "\n",
    "# --- Estatísticas por canal (calculadas sobre os píxeis JÁ normalizados) ------\n",
    "estatisticas = {\n",
    "    'imagem_id': np.arange(N_LINHAS),\n",
    "    'conjunto': ['treino'] * N_LINHAS,\n",
    "    'etiqueta': y_train.flatten()[:N_LINHAS].astype('int32'),  # uint8 -> int32 (display não suporta uint8)\n",
    "    'classe': [CLASS_NAMES[e] for e in y_train.flatten()[:N_LINHAS]],\n",
    "    'media_R': x_train_norm[:N_LINHAS].mean(axis=(1, 2))[:, 0],\n",
    "    'media_G': x_train_norm[:N_LINHAS].mean(axis=(1, 2))[:, 1],\n",
    "    'media_B': x_train_norm[:N_LINHAS].mean(axis=(1, 2))[:, 2],\n",
    "    'min_pixel': x_train_norm[:N_LINHAS].min(axis=(1, 2, 3)),\n",
    "    'max_pixel': x_train_norm[:N_LINHAS].max(axis=(1, 2, 3)),\n",
    "    'desvio_pixel': x_train_norm[:N_LINHAS].std(axis=(1, 2, 3)),\n",
    "}\n",
    "\n",
    "df_preview = pd.DataFrame(estatisticas)\n",
    "\n",
    "# --- Colunas do one-hot encoding (a etiqueta que entra na CNN) ---------------\n",
    "for c in range(10):\n",
    "    df_preview[f'onehot_{c}'] = y_train_onehot[:N_LINHAS, c].astype(int)\n",
    "\n",
    "# --- Validação da tabela (regra 8) ---------------------------------------------\n",
    "print(f'Dimensões da tabela: {df_preview.shape[0]} linhas x {df_preview.shape[1]} colunas')\n",
    "print(f'Valores nulos: {df_preview.isna().sum().sum()}')\n",
    "assert df_preview.shape == (77, 20), 'Dimensões inesperadas na tabela de amostra!'\n",
    "assert df_preview.isna().sum().sum() == 0, 'Valores nulos na tabela de amostra!'\n",
