    "# positivos define onde uma confirmação humana é obrigatória.\n",
    "#\n",
    "# Nota metodológica: falsos positivos da classe X = imagens de OUTRAS classes\n",
    "# previstas como X (soma da coluna X menos a diagonal). Analisamos em valor\n",
    "# absoluto (nº de imagens) e em taxa (FP / total de previsões da classe = 1 -\n",
    "# precisão), porque as duas leituras podem divergir.\n",
    "#\n",
    "# Input:  matriz_confusao, CLASS_NAMES (STEP 8)\n",
    "# Output: categoria com mais falsos positivos (absoluto e taxa) + tabela completa\n",
    "#\n",
    "# Operações:\n",
    "#   - Calcular falsos positivos por classe (coluna - diagonal)\n",
    "#   - Calcular a taxa de FP sobre o total de previsões de cada classe\n",
    "#   - Identificar o máximo em ambas as leituras e responder com os dados\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "# --- Falsos positivos por classe (colunas da matriz de confusão) -------------\n",
    "previstos_por_classe = matriz_confusao.sum(axis=0)          # total de previsões por classe\n",
    "fp_por_classe = previstos_por_classe - np.diag(matriz_confusao)  # previsões erradas por classe\n",
    "taxa_fp = fp_por_classe / previstos_por_classe               # 1 - precisão\n",
    "\n",
    "assert fp_por_classe.sum() == total_erros, 'FP inconsistentes com o total de erros!'\n",
    "assert fp_por_classe.min() >= 0, 'Falsos positivos negativos!'\n",
    "\n",
    "# --- Tabela ordenada por FP absolutos -----------------------------------------\n",
    "ordem_fp = np.argsort(fp_por_classe)[::-1]\n",
    "print('P6 — Qual a categoria com mais falsos positivos?')\n",
    "print()\n",
    "print('Falsos positivos por categoria (ordenado):')\n",
    "for pos, c in enumerate(ordem_fp, start=1):\n",
    "    print(f'  {pos:>2}. {CLASS_NAMES[c]:<10} {int(fp_por_classe[c]):>3} FP '\n",
