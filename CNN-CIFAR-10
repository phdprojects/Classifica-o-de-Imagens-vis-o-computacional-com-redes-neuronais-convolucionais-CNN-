    "# ==============================================================================\n",
    "# P4: O MODELO ERRA MAIS EM IMAGENS COM FUNDOS COMPLEXOS?\n",
    "# ==============================================================================\n",
    "# Pergunta: imagens visualmente mais 'carregadas' (mais textura, mais contornos,\n",
    "# fundos detalhados) têm mais erros do que imagens 'limpas'?\n",
    "#\n",
    "# Justificação: em produção, saber se o desempenho degrada com a complexidade\n",
    "# visual define as condições de captura recomendadas (fundo limpo vs qualquer\n",
    "# fundo) e o esforço de amostragem necessário.\n",
    "#\n",
    "# Nota metodológica: o CIFAR-10 não traz etiquetas de fundo. Usamos um PROXY\n",
    "# mensurável — a densidade de contornos (variação média de píxeis entre vizinhos,\n",
    "# eixos x e y, em escala de cinzentos) — e dividimos as imagens de teste em\n",
    "# tercis: 'simples' (33% menos densas), 'médio', 'complexo' (33% mais densas).\n",
    "# Para evitar enviesamento pela composição de classes, a comparação principal é\n",
    "# DENTRO de cada classe.\n",
    "#\n",
    "# Input:  x_test_norm, y_true, y_pred, CLASS_NAMES (STEPS 4 e 8)\n",
    "# Output: taxa de erro por nível de complexidade (global e por classe)\n",
    "#\n",
    "# Operações:\n",
    "#   - Calcular densidade de contornos por imagem (proxy de complexidade)\n",
    "#   - Dividir em tercis: simples / médio / complexo\n",
    "#   - Taxa de erro por tercil (global) e por classe (controle da composição)\n",
    "#   - Concluir a partir dos dados (SIM/NÃO calculado, não assumido)\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "# --- Proxy de complexidade: densidade de contornos ---------------------------\n",
    "cinza = x_test_norm.mean(axis=3)                       # escala de cinzentos (10000, 32, 32)\n",
    "grad_x = np.abs(np.diff(cinza, axis=2)).mean(axis=(1, 2))  # variação horizontal média\n",
    "grad_y = np.abs(np.diff(cinza, axis=1)).mean(axis=(1, 2))  # variação vertical média\n",
    "densidade_contornos = grad_x + grad_y\n",
    "\n",
    "errou = (y_pred != y_true)\n",
    "\n",
    "# --- Tercis de complexidade --------------------------------------------------\n",
    "q33, q66 = np.quantile(densidade_contornos, [1/3, 2/3])\n",
    "nivel = np.where(densidade_contornos <= q33, 'simples',\n",
    "                np.where(densidade_contornos >= q66, 'complexo', 'médio'))\n",
    "\n",
    "assert (nivel == 'simples').sum() > 2500 and (nivel == 'complexo').sum() > 2500, 'Tercis desequilibrados!'\n",
